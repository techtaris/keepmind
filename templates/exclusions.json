{
  "prune_dirs": [".git","node_modules",".venv","venv","env","venvs","__pycache__",".mypy_cache",".pytest_cache",".ruff_cache",".tox","dist","build","out","target",".next",".nuxt",".svelte-kit",".angular",".expo",".dart_tool",".gradle",".turbo",".parcel-cache",".cache","coverage","bin","obj","vendor","site-packages",".pnpm-store",".yarn","bower_components","Pods","DerivedData",".terraform",".vercel",".vercel-stage",".netlify",".serverless",".wrangler","__MACOSX",".Trash",".obsidian"],
  "dot_dir_allow": [".github",".agents",".claude",".codex",".cursor"],
  "dot_dir_allow_subpaths": {".claude": ["skills","commands","agents"], ".codex": ["skills","prompts"], ".cursor": ["rules"]},
  "browser_profile_dir_regex": "^\\.(chrome.*|print-chrome)$",
  "a_docs_exts": ["md","txt"],
  "name_regex": [
    "^\\.env($|\\.)",
    "\\.(pem|key|p12|pfx|crt|cer|der|jks|keystore|kdbx|ovpn|gpg|asc|ppk|p8|mobileprovision)$",
    "^id_(rsa|dsa|ecdsa|ed25519)", "^(known_hosts|authorized_keys)$",
    "^(\\.npmrc|\\.pypirc|\\.netrc|\\.git-credentials|\\.htpasswd|\\.dockercfg|\\.pgpass)$",
    "\\.tfstate", "\\.tfvars$", "^secrets?\\.(ya?ml|json|toml)$", "credential.*\\.json$", "client_secret.*\\.json$", "service[-_]account.*\\.json$",
    "^settings(\\.local)?\\.json$", "\\.(eml|mbox|msg)$", "^_chat\\.txt$", "^whatsapp chat.*\\.zip$",
    "\\.(sqlite|sqlite3|db|duckdb)$",
    "(^package-lock\\.json$|^yarn\\.lock$|^pnpm-lock\\.yaml$|\\.lock$|^npm-shrinkwrap\\.json$|\\.min\\.(js|css)$|\\.map$)"
  ],
  "text_exts": ["md","mdx","txt","rst","org","adoc","markdown","py","js","ts","tsx","jsx","mjs","cjs","go","rs","java","kt","swift","c","h","cpp","hpp","cs","rb","php","sh","bash","zsh","ps1","psm1","sql","lua","r","scala","dart","vue","svelte","css","scss","bicep","tf","hcl","gradle","yaml","yml","toml","ini","cfg","conf","xml","json","jsonc","ipynb","html","htm","csv","tsv","canvas","base"],
  "office_exts": ["pdf","docx","pptx","xlsx"],
  "small_limit_exts": ["json","jsonc","yaml","yml","csv","tsv","xml","html","htm"],
  "max_text_bytes": 2000000, "max_small_bytes": 256000, "max_office_bytes": 50000000,
  "secret_high": {
    "aws_akid": "\\b(AKIA|ASIA)[0-9A-Z]{16}\\b",
    "github_token": "\\b(gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{40,})\\b",
    "sk_key": "\\bsk-(ant-|proj-)?[A-Za-z0-9_\\-]{32,}",
    "slack_token": "\\bxox[baprs]-[A-Za-z0-9-]{10,}",
    "google_api_key": "\\bAIza[0-9A-Za-z_\\-]{35}\\b",
    "private_key_pem": "-----BEGIN (RSA |EC |OPENSSH |DSA |PGP |ENCRYPTED )?PRIVATE KEY-----",
    "jwt": "\\beyJ[A-Za-z0-9_\\-]{15,}\\.eyJ[A-Za-z0-9_\\-]{15,}\\.[A-Za-z0-9_\\-]{10,}",
    "npm_token": "_authToken\\s*=\\s*[^\\s$]{12,}"
  },
  "secret_low": {
    "url_with_creds": "\\b[a-z][a-z0-9+.\\-]*://[^\\s:/@'\"]{2,}:[^\\s@'\"]{6,}@[A-Za-z0-9.\\-]+",
    "assign_secret": "(?i)\\b(api[_-]?key|secret[_-]?key|client[_-]?secret|access[_-]?token|auth[_-]?token|password|passwd)\\b[\"']?\\s*[:=]\\s*[\"'][^\"'\\s$<>{}]{12,}[\"']"
  }
}
